  name?: string;
  email?: string;
  role?: "admin" | "member";
  age?: number | null;
  tags?: string[];
  profile?: {
    bio?: string;
    "favorite-color"?: string;
  };
};

/** A \`blog-posts\` record. */
type BlogPostsRecord = { [key: string]: unknown };
/** Query for \`mantle["blog-posts"].find()\`. */
type BlogPostsQuery = {
  /** Filter clause. Keys are field names; values are literals or operator objects. */
  where?: {
    /** Any clause may match. */
    $or?: { [key: string]: unknown }[];
    /** All clauses must match. */
    $and?: { [key: string]: unknown }[];
  } & { [key: string]: unknown };
  /** Number of records to skip (offset pagination). */
  skip?: number;
  /** Sort order per field. */
  sort?: { [key: string]: "asc" | "desc" };
  /** Fields to return. Use to keep results small. */
  select?: string[];
  /** Maximum records to return. Default 25; requests above 100 are clamped. Page with skip. */
