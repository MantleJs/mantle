declare const mantle: {
  users: {
    /** Find users records matching a query. Results are paginated — check the returned total and page with query.skip/query.limit. */
    find(query?: UsersQuery): Promise<UsersRecord[] | Paginated<UsersRecord>>;
    /** Get a single users record by id. */
    get(id: Id, query?: UsersIdQuery): Promise<UsersRecord>;
    /** Create a new users record. */
    create(data: UsersData): Promise<UsersRecord>;
    /** Update a users record by id. Replaces the entire record — omitted fields are lost; use mantle.users.patch() for partial changes. */
