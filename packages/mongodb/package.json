  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "description": "MongoDB adapter for Mantle JS — MongoRepository with full QueryParams support and Atlas Vector Search",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MantleJs/mantle.git",
    "directory": "packages/mongodb"
  },
  "homepage": "https://github.com/MantleJs/mantle/tree/main/packages/mongodb#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mantle",
    "mongodb",
    "atlas",
    "vector",
    "database",
    "repository"
  ],
  "peerDependencies": {
    "@mantlejs/mantle": "^0.1.0",
    "mongodb": "^6.0.0 || ^7.0.0"
  }
