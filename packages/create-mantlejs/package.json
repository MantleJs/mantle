{
  "name": "create-mantlejs",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "create-mantlejs": "./dist/bin/create-mantlejs.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@mantle/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "name": "create-mantlejs",
    "targets": {
      "e2e-scaffold": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node e2e/scaffold-smoke.mjs",
          "cwd": "packages/create-mantlejs"
        },
        "dependsOn": [
          {
            "projects": [
              "mantle",
              "express",
              "schema",
              "memory",
              "cli",
              "create-mantlejs"
            ],
            "target": "build"
          }
        ]
      }
    }
  },
  "dependencies": {
    "tslib": "^2.3.0",
    "@mantlejs/cli": "*"
  },
  "description": "Project initializer for Mantle JS — scaffold a new Mantle application via npm create mantlejs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MantleJs/mantle.git",
    "directory": "packages/create-mantlejs"
  },
  "homepage": "https://github.com/MantleJs/mantle/tree/main/packages/create-mantlejs#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mantle",
    "create",
    "scaffold",
    "initializer",
    "typescript"
  ]
}
