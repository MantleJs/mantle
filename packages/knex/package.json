{
  "name": "@mantlejs/knex",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@mantle/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "name": "knex"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "description": "SQL database adapter for Mantle JS via Knex.js (PostgreSQL, MySQL, SQLite, MSSQL)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MantleJs/mantle.git",
    "directory": "packages/knex"
  },
  "homepage": "https://github.com/MantleJs/mantle/tree/main/packages/knex#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mantle",
    "knex",
    "sql",
    "postgresql",
    "mysql",
    "sqlite",
    "database"
  ],
  "peerDependencies": {
    "@mantlejs/mantle": "^0.0.1",
    "knex": "^3.0.0"
  }
}
