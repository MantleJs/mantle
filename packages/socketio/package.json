{
  "name": "@mantlejs/socketio",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@mantle/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "name": "socketio"
  },
  "description": "Socket.IO transport adapter for Mantle JS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MantleJs/mantle.git",
    "directory": "packages/socketio"
  },
  "homepage": "https://github.com/MantleJs/mantle/tree/main/packages/socketio#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mantle",
    "socketio",
    "websocket",
    "realtime"
  ],
  "dependencies": {
    "socket.io": "^4.8.1",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@mantlejs/mantle": "^0.1.0"
  }
