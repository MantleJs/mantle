{
  "name": "mantle-website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "mantlejs.com — the Mantle JS docs site (Astro Starlight). Deployed, never published to npm.",
  "nx": {
    "name": "website",
    "tags": [
      "type:app"
    ],
    "implicitDependencies": [
      "ui-registry"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "astro build",
          "cwd": "website"
        },
        "dependsOn": [
          {
            "projects": [
              "client",
              "react"
            ],
            "target": "build"
          },
          {
            "projects": [
              "ui-registry"
            ],
            "target": "build-registry"
          }
        ],
        "inputs": [
          "default",
          "{workspaceRoot}/CLAUDE.md",
          "{workspaceRoot}/packages/*/README.md",
          "{workspaceRoot}/packages/*/package.json",
          "{workspaceRoot}/packages/*/tsconfig*.json",
          "{workspaceRoot}/packages/*/src/**/*.ts",
          "{workspaceRoot}/registry/README.md",
          "{workspaceRoot}/registry/src/**/*",
          "{workspaceRoot}/registry/registry.json"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "cache": true
      },
      "dev": {
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "command": "astro dev",
          "cwd": "website"
        },
        "dependsOn": [
          {
            "projects": [
              "client",
              "react"
            ],
            "target": "build"
          }
        ]
      },
      "preview": {
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "command": "astro preview",
          "cwd": "website"
        },
        "dependsOn": [
          "build"
        ]
      }
    }
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@astrojs/starlight": "^0.42.6",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@mantlejs/client": "^0.2.0",
    "@mantlejs/react": "^0.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.2",
    "astro": "^7.3.8",
    "cookie": "^2.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "starlight-links-validator": "^0.26.0",
    "starlight-llms-txt": "^0.12.0",
    "starlight-typedoc": "^0.23.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1"
  }
}
