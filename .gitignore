# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
test-output
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.claude/worktrees
.claude/settings.local.json

vitest.config.*.timestamp*
.nx/polygraph

# examples — generated at build/run time
examples/realtime-chat/public/app.js
examples/realtime-chat/chat.db
examples/knowledge-base/**/uploads

# Mantle UI registry — `nx run ui-registry:build-registry` output (hosted by the website, not committed)
registry/public/r
vite.config.*.timestamp*

# Website — Astro build output/cache, and the API reference starlight-typedoc generates on every build
website/.astro
website/src/content/docs/api

# local env files (copied from .env.example — never commit real secrets)
.env
.env.local
.local.env