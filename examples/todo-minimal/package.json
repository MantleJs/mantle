{
  "name": "todo-minimal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The smallest possible Mantle app: @mantlejs/http + @mantlejs/memory, one service, no external infra.",
  "nx": {
    "name": "todo-minimal",
    "targets": {
      "serve": {
        "executor": "nx:run-commands",
        "dependsOn": ["build"],
        "options": {
          "command": "node dist/index.js",
          "cwd": "{projectRoot}"
        }
      }
    }
  },
  "dependencies": {
    "@mantlejs/mantle": "^0.1.0",
    "@mantlejs/http": "^0.1.0",
    "@mantlejs/memory": "^0.1.0",
    "tslib": "^2.3.0"
  }
}
