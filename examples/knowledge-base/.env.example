# Copy to .env and fill in what you need. Nothing here is required to boot the app —
# it runs on local auth + disk storage + single-instance realtime with zero secrets.

# --- Core (docker-compose defaults shown) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/knowledge_base
JWT_SECRET=dev-secret-change-me
NODE_ENV=development
# MANTLE_APP__PORT=3030

# --- Redis (optional: multi-instance refresh-token/OAuth-state sharing + realtime fan-out) ---
# REDIS_URL=redis://localhost:6379

# --- OAuth strategies (each activates only when its own vars are all set) ---
# Successful/failed logins redirect back to WEB_URL with tokens (or an error) in the URL
# fragment — see web/src/app/app.tsx, which picks them up on load.
# WEB_URL=http://localhost:4200
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# --- Attachments storage (falls back to disk under ./uploads) ---
# S3_BUCKET=
# AWS_REGION=us-east-1
# GCS_BUCKET=

# --- Embeddings (falls back to the deterministic local embedder) ---
# EMBEDDER_URL=
# EMBEDDER_DIMENSIONS=256

# --- Web frontend ---
# VITE_API_URL=http://localhost:3030
